    {
      "id": 16,
      "type": "timeseries",
      "title": "Compliance gate (outbound messages)",
      "description": "The proactive agent's check before a message is scheduled. Runs when contacts are composed (seeded demo, outbound runs).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
