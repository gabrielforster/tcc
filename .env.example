# Copy to .env and adjust: `cp .env.example .env`. The .env file is never committed.
#
# Every variable below says who reads it and where it lives in production:
#   reads:  the `Settings` field in src/collection/config.py (the name, lower-cased), or the
#           command/file that reads it when it is not a setting;
#   prod:   `SSM /tcc/prod/<NAME>` -- a Parameter Store entry that deploy/deploy.sh renders
#           into /opt/tcc/.env on the host; `compose` -- fixed in deploy/compose.prod.yml;
#           `image` -- set by the Dockerfile; `default` -- not set, the code's default holds.
#
# Section 1 is development and is live: these values are the services in docker-compose.yml,
# and they are also config.py's defaults, so the app runs even with no .env at all.
# Section 2 is what only production sets; it is commented out and documents, not configures.

# =========================================================== 1. development (live values)

# --- record ---------------------------------------------------------------------------
# reads: settings.database_url | prod: compose (postgresql+psycopg://...@postgres:5432,
#        password from POSTGRES_PASSWORD)
DATABASE_URL=postgresql+psycopg://collection:collection@localhost:5433/collection
# The only database the tests touch; unset, every database test skips. Keep it separate
# from DATABASE_URL: the migration round-trip test downgrades to base. Create it once:
#   docker compose exec postgres createdb -U collection collection_test
# reads: settings.test_database_url (tests/conftest.py) | prod: never set
TEST_DATABASE_URL=postgresql+psycopg://collection:collection@localhost:5433/collection_test

# --- object storage: MinIO from docker-compose.yml --------------------------------------
# In production all three of these are empty (compose sets them so): no endpoint is AWS S3,
# no keys is the instance role. See config.py.
# reads: settings.s3_endpoint_url | prod: compose (empty)
S3_ENDPOINT_URL=http://localhost:9000
# reads: settings.s3_bucket | prod: SSM /tcc/prod/S3_BUCKET
S3_BUCKET=collection
# reads: settings.s3_access_key, settings.s3_secret_key | prod: compose (empty)
S3_ACCESS_KEY=collection
S3_SECRET_KEY=collection-secret

# --- the chat's tenant ------------------------------------------------------------------
# Which tenant a chat request belongs to when it names none. Both empty runs the chat on
# the in-memory store, with no database behind it. The slug is what `make seed` creates,
# so it can be written before the database exists; `make dev` sets it to desenvolvimento
# for the containers by itself. A key, if set, wins.
# reads: settings.default_tenant_slug | prod: SSM /tcc/prod/DEFAULT_TENANT_SLUG (optional)
DEFAULT_TENANT_SLUG=
# reads: settings.default_tenant_key | prod: default (empty)
DEFAULT_TENANT_KEY=

# The pipeline commands take their tenant from COLLECTION_TENANT, read from the shell
# rather than from this file -- it is a CLI option's fallback, not a setting:
#   export COLLECTION_TENANT=desenvolvimento
# reads: the --tenant option in cli.py | prod: not used (no pipeline runs there)

# --- data -------------------------------------------------------------------------------
# synthetic | home-credit | bank-marketing | erp
#   synthetic      generated, covers the whole domain; the default and the test fixture
#   home-credit    real payment behavior; needs the Kaggle files in data/raw/home-credit/
#   bank-marketing real contact attempts; downloads from UCI on first use
#   erp            the real extraction, once ERP_DATABASE_URL is set
# reads: settings.data_source | prod: SSM /tcc/prod/DATA_SOURCE (synthetic)
DATA_SOURCE=synthetic
# reads: settings.synthetic_seed, _n_customers, _n_invoices | prod: default
SYNTHETIC_SEED=42
SYNTHETIC_N_CUSTOMERS=1200
SYNTHETIC_N_INVOICES=12000
# reads: settings.erp_database_url | prod: default (empty: no ERP)
ERP_DATABASE_URL=

# --- embeddings: the dimension is baked into the schema, so it must match the model ------
# reads: settings.embedding_model, settings.embedding_dimensions | prod: default (and the
#        image bakes in exactly this model)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# --- generation, for the LLM arms. Without a provider the template arms still run --------
#   anthropic  hosted Claude; needs ANTHROPIC_API_KEY and `uv sync --extra llm`
#   openai     any OpenAI-compatible server. The default base URL is the local Ollama
#              that `make ollama` starts -- no account, no key. Groq or OpenRouter are
#              the same provider with their base URL and LLM_API_KEY.
# reads: settings.llm_provider, settings.llm_model | prod: SSM /tcc/prod/LLM_PROVIDER, LLM_MODEL
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# reads: settings.anthropic_api_key | prod: SSM /tcc/prod/ANTHROPIC_API_KEY (SecureString)
ANTHROPIC_API_KEY=
# reads: settings.llm_base_url, llm_api_key, llm_timeout | prod: SSM /tcc/prod/LLM_BASE_URL
#        (if not the default), LLM_API_KEY (SecureString); LLM_TIMEOUT default
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_TIMEOUT=180

# --- keys -------------------------------------------------------------------------------
# Pseudonymization salt (LGPD). Generate your own: openssl rand -hex 32
# Every key the system needs is derived from this one: a pseudonymization key per tenant,
# and the key that signs chat identity tokens. Rotating it invalidates both -- re-run
# `collection ingest` per tenant afterwards, and live chat tokens stop verifying.
# reads: settings.anonymization_salt | prod: SSM /tcc/prod/ANONYMIZATION_SALT (SecureString)
ANONYMIZATION_SALT=change-this-salt

# --- the voice call: LiveKit from docker-compose, in dev mode ----------------------------
# The dev-mode key pair grants nothing outside this machine; production overrides all three.
# reads: settings.livekit_url | prod: compose (wss://$RTC_DOMAIN)
LIVEKIT_URL=ws://127.0.0.1:7880
# reads: settings.livekit_api_key, livekit_api_secret | prod: SSM /tcc/prod/LIVEKIT_API_KEY,
#        LIVEKIT_API_SECRET (SecureString); compose also hands them to the LiveKit server
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- housekeeping -----------------------------------------------------------------------
# Cores for training, search and permutation importance; -1 takes them all.
# reads: settings.n_jobs | prod: default
N_JOBS=-1
# How long a closed conversation's transcript is kept before `collection conversations
# purge` erases it (LGPD art. 15-16). The conversation row survives either way.
# reads: settings.transcript_retention_days | prod: default
TRANSCRIPT_RETENTION_DAYS=180

# Not listed above because nothing needs changing in development, all with config.py
# defaults: CHAT_ENABLED, CHAT_ALLOWED_ORIGINS, CHAT_SEED_DEMO (`serve --seed-demo` sets
# it), DIR_CALLS, DIR_VOICES (image: /opt/models/voices), APP_VERSION (image: the commit),
# COLLECTION_HOST (read by `serve`/`call serve`; image: 0.0.0.0, `make dev`: 127.0.0.1).

# ============================================== 2. production only (documentation, unset)

# reads: deploy/Caddyfile, compose.prod.yml | prod: SSM /tcc/prod/<NAME>
# APP_DOMAIN=tcc.gabrielfr.com
# RTC_DOMAIN=rtc.tcc.gabrielfr.com
# TURN_DOMAIN=turn.tcc.gabrielfr.com
# GRAFANA_DOMAIN=grafana.tcc.gabrielfr.com
# reads: settings.aws_region (and the AWS SDK) | prod: SSM /tcc/prod/AWS_REGION
# AWS_REGION=us-east-1
# The database password; compose builds DATABASE_URL from it, so keep it URL-safe (hex).
# reads: compose.prod.yml (postgres, DATABASE_URL) | prod: SSM /tcc/prod/POSTGRES_PASSWORD
# POSTGRES_PASSWORD=
# reads: the observability stack | prod: SSM /tcc/prod/GRAFANA_ADMIN_PASSWORD,
#        GRAFANA_VIEWER_PASSWORD (SecureString)
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_VIEWER_PASSWORD=
# Telemetry is off while this is unset (tests, plain local runs).
# reads: the OpenTelemetry SDK | prod: compose (http://lgtm:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# reads: deploy.sh / compose.prod.yml, never the app | prod: deploy.sh's argument
# IMAGE_TAG=
