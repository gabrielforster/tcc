# Copy to .env and adjust. The .env file is never committed.
DATABASE_URL=postgresql+psycopg://collection:collection@localhost:5433/collection
REDIS_URL=redis://localhost:6380/0

# Data source: synthetic | home-credit | bank-marketing | erp
#   synthetic      generated, covers the whole domain; the default and the test fixture
#   home-credit    real payment behavior; needs the Kaggle files in data/raw/home-credit/
#   bank-marketing real contact attempts; downloads from UCI on first use
#   erp            the real extraction, once ERP_DATABASE_URL is set
DATA_SOURCE=synthetic
SYNTHETIC_SEED=42
SYNTHETIC_N_CUSTOMERS=1200
SYNTHETIC_N_INVOICES=12000

# Pseudonymization salt (LGPD). Generate your own: openssl rand -hex 32
ANONYMIZATION_SALT=change-this-salt

# ERP connection (schedule deliverable 3, once access is granted)
ERP_DATABASE_URL=
