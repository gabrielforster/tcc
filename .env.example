# Copy to .env and adjust. The .env file is never committed.
DATABASE_URL=postgresql+psycopg://collection:collection@localhost:5433/collection
# Tests use this database when set. Keep it separate from DATABASE_URL: the migration
# round-trip test downgrades to base and is skipped unless this is set. Create it once:
#   docker compose exec postgres createdb -U collection collection_test
TEST_DATABASE_URL=postgresql+psycopg://collection:collection@localhost:5433/collection_test
REDIS_URL=redis://localhost:6380/0

# Object storage (MinIO from docker-compose.yml)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=collection
S3_ACCESS_KEY=collection
S3_SECRET_KEY=collection-secret

# Embeddings. The dimension must match the model; it is baked into the schema.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# Data source: synthetic | home-credit | bank-marketing | erp
#   synthetic      generated, covers the whole domain; the default and the test fixture
#   home-credit    real payment behavior; needs the Kaggle files in data/raw/home-credit/
#   bank-marketing real contact attempts; downloads from UCI on first use
#   erp            the real extraction, once ERP_DATABASE_URL is set
DATA_SOURCE=synthetic
SYNTHETIC_SEED=42
SYNTHETIC_N_CUSTOMERS=1200
SYNTHETIC_N_INVOICES=12000

# The tenant a chat request belongs to when it names none. Empty runs the chat on the
# in-memory store, with no database behind it: that is what a fresh clone does. Set it to
# a tenant's public tenant_key to serve that tenant's conversations from the record.
# `make seed` creates a development tenant and prints its key.
DEFAULT_TENANT_KEY=

# The pipeline commands take their tenant from COLLECTION_TENANT, which is read from the
# shell rather than from this file -- it is a CLI option's fallback, not a setting. After
# `make seed`:  export COLLECTION_TENANT=desenvolvimento

# Pseudonymization salt (LGPD). Generate your own: openssl rand -hex 32
ANONYMIZATION_SALT=change-this-salt

# ERP connection (schedule deliverable 3, once access is granted)
ERP_DATABASE_URL=

# Cores for training, search and permutation importance; -1 takes them all
N_JOBS=-1
